  "cards": [
    {
      "dot": "rose",
      "title": "Why not a script",
      "items": [
        "Upload scripts hard-code one account and break on page changes",
        "Every stage here is a prompt, a contract, or a schema — swap parts independently"
      ]
    },
    {
      "dot": "emerald",
      "title": "What's enforced",
      "items": [
        "Hotspot re-searched live; gone means stop, never force",
        "BGM counts only with title plus duration; cover plus upload gates",
        "Zero credential storage: manual login, publisher owns its session"
      ]
    },
    {
      "dot": "cyan",
      "title": "Swap anything",
      "items": [
        "Model, agent system, image generator, publisher — each replaceable",
        "Industry profile JSON generalizes the flow to any niche",
        "Logs in files (CSV plus screenshots), not in chat"
      ]
    }
